{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.ai/protocol/tfsb-studio-v1/requests-1.1.schema.json",
  "title": "TFSB Studio protocol 1.1 requests and client notifications",
  "$defs": {
    "id": { "$ref": "envelope.schema.json#/$defs/id" },
    "nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
    "handle": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idText": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]*)$", "maxLength": 16 },
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle"],
      "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" } }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "pageSize"],
      "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "pageSize": { "type": "integer", "minimum": 1, "maximum": 128 }, "cursor": { "type": "string", "minLength": 1, "maxLength": 16384 } }
    },
    "sourceHandles": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/handle" } },
    "optionalSourceHandles": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/handle" } },
    "profileIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "parameters": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["profileId", "values"],
        "properties": {
          "profileId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "values": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["parameter", "value"], "properties": { "parameter": { "$ref": "#/$defs/idText" }, "value": { "type": "string", "maxLength": 256 } } } }
        }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/id" }, "method": { "type": "string" }, "params": { "type": "object" } }
    },
    "initialize": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/id" }, "method": { "const": "initialize" },
        "params": {
          "type": "object", "additionalProperties": false, "required": ["protocol", "minVersion", "maxVersion", "client", "capabilities"],
          "properties": {
            "protocol": { "const": "tfsb.studio" }, "minVersion": { "$ref": "#/$defs/version" }, "maxVersion": { "$ref": "#/$defs/version" },
            "client": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "version": { "type": "string", "minLength": 1, "maxLength": 64 } } },
            "capabilities": { "type": "object", "additionalProperties": false, "required": ["progress", "cancellation"], "properties": { "progress": { "type": "boolean" }, "cancellation": { "type": "boolean" } } }
          }
        }
      }
    },
    "sourceOpen": {
      "$ref": "#/$defs/request",
      "properties": {
        "method": { "const": "source.open" },
        "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "path"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "path": { "$ref": "#/$defs/absolutePath" }, "purpose": { "enum": ["content", "source-map", "normalization-map", "shard-manifest", "brand-bundle", "npm-installed-package"] } } }
      }
    },
    "qaProfile": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "profileId"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "profileId": { "$ref": "#/$defs/idText" } } },
    "consumerPlan": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "sourceHandles"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "sourceHandles": { "$ref": "#/$defs/sourceHandles" }, "profiles": { "$ref": "#/$defs/profileIds" }, "parameters": { "$ref": "#/$defs/parameters" } } }
  },
  "anyOf": [
    { "$ref": "requests.schema.json" },
    { "$ref": "#/$defs/initialize" },
    { "$ref": "#/$defs/sourceOpen" },
    { "$ref": "#/$defs/request", "properties": { "method": { "enum": ["brand.status", "brand.recipe.graph", "brand.export.capability"] }, "params": { "$ref": "#/$defs/project" } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "enum": ["brand.family.list", "brand.token.list", "brand.export.status"] }, "params": { "$ref": "#/$defs/page" } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "enum": ["brand.qa.profile.get", "brand.qa.result.get"] }, "params": { "$ref": "#/$defs/qaProfile" } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.diff" }, "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "sourceHandle"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "sourceHandle": { "$ref": "#/$defs/handle" } } } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.consumer.profile.list" }, "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "pageSize"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "sourceHandles": { "$ref": "#/$defs/optionalSourceHandles" }, "pageSize": { "type": "integer", "minimum": 1, "maximum": 128 }, "cursor": { "type": "string", "minLength": 1, "maxLength": 16384 } } } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.consumer.lock.status" }, "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "sourceHandles": { "$ref": "#/$defs/optionalSourceHandles" } } } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.derive.plan" }, "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "selection"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "selection": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "all" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "recipeIds"], "properties": { "kind": { "const": "recipes" }, "recipeIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/idText" } } } }] } } } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.qa.baseline.plan" }, "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "profileId", "caseId"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "profileId": { "$ref": "#/$defs/idText" }, "caseId": { "$ref": "#/$defs/idText" } } } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.consumer.install.plan" }, "params": { "$ref": "#/$defs/consumerPlan", "required": ["sessionNonce", "projectHandle", "sourceHandles", "profiles"] } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.consumer.sync.plan" }, "params": { "$ref": "#/$defs/consumerPlan" } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "brand.export.plan" }, "params": { "type": "object", "additionalProperties": false, "required": ["sessionNonce", "projectHandle", "profileId"], "properties": { "sessionNonce": { "$ref": "#/$defs/nonce" }, "projectHandle": { "$ref": "#/$defs/handle" }, "profileId": { "$ref": "#/$defs/idText" }, "outputIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/idText" } } } } } }
  ]
}
