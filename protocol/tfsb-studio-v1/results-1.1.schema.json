{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.ai/protocol/tfsb-studio-v1/results-1.1.schema.json",
  "title": "TFSB Studio protocol 1.1 result and server-notification shapes",
  "$defs": {
    "id": { "$ref": "envelope.schema.json#/$defs/id" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "handle": { "type": "string", "minLength": 1, "maxLength": 128 },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "relativeIdentity": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$)).+$" },
    "json": {
      "oneOf": [
        { "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "rasterStatus": { "type": "object", "additionalProperties": false, "required": ["available"], "properties": { "available": { "type": "boolean" } } },
    "brandMethods": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "familyList", "tokenList", "recipeGraph", "qaProfileGet", "qaResultGet", "diff", "consumerProfileList", "consumerLockStatus", "exportCapability", "exportStatus", "derivePlan", "qaBaselinePlan", "consumerInstallPlan", "consumerSyncPlan", "exportPlan"],
      "properties": { "status": { "const": true }, "familyList": { "const": true }, "tokenList": { "const": true }, "recipeGraph": { "const": true }, "qaProfileGet": { "const": true }, "qaResultGet": { "const": true }, "diff": { "const": true }, "consumerProfileList": { "const": true }, "consumerLockStatus": { "const": true }, "exportCapability": { "const": true }, "exportStatus": { "const": true }, "derivePlan": { "const": true }, "qaBaselinePlan": { "type": "boolean" }, "consumerInstallPlan": { "const": true }, "consumerSyncPlan": { "const": true }, "exportPlan": { "type": "boolean" } }
    },
    "brandCapability": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "methods", "sourcePurposes", "raster", "limits"],
      "properties": {
        "schemaVersion": { "const": 1 }, "methods": { "$ref": "#/$defs/brandMethods" },
        "sourcePurposes": { "type": "object", "additionalProperties": false, "required": ["brandBundle", "npmInstalledPackage"], "properties": { "brandBundle": { "const": true }, "npmInstalledPackage": { "const": true } } },
        "raster": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["available"], "properties": { "available": { "const": false } } }, { "type": "object", "additionalProperties": false, "required": ["available", "adapterId", "rendererVersion", "qualificationId", "platformClaim"], "properties": { "available": { "const": true }, "adapterId": { "const": "resvg-png-v1" }, "rendererVersion": { "type": "string" }, "qualificationId": { "type": "string" }, "platformClaim": { "const": "darwin-arm64" } } }] },
        "limits": { "type": "object", "additionalProperties": false, "required": ["pageSizeMin", "pageSizeDefault", "pageSizeMax", "maxSourcePackages", "maxSelectedProfiles", "maxQaResultBytes", "maxDiffResultBytes", "maxExportOutputs"], "properties": { "pageSizeMin": { "const": 1 }, "pageSizeDefault": { "const": 64 }, "pageSizeMax": { "const": 128 }, "maxSourcePackages": { "const": 8 }, "maxSelectedProfiles": { "const": 8 }, "maxQaResultBytes": { "const": 16777216 }, "maxDiffResultBytes": { "const": 16777216 }, "maxExportOutputs": { "const": 128 } } }
      }
    },
    "initializeResult": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "selectedVersion", "server", "sessionNonce", "capabilities"],
      "properties": {
        "protocol": { "const": "tfsb.studio" }, "selectedVersion": { "const": "1.1" }, "sessionNonce": { "$ref": "#/$defs/token" },
        "server": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "tfsb-studio-service" }, "version": { "type": "string", "minLength": 1, "maxLength": 64 } } },
        "capabilities": { "type": "object", "additionalProperties": false, "required": ["methods", "limits", "brand"], "properties": { "methods": { "$ref": "results.schema.json#/$defs/initializeResult/properties/capabilities/properties/methods" }, "limits": { "$ref": "results.schema.json#/$defs/initializeResult/properties/capabilities/properties/limits" }, "brand": { "$ref": "#/$defs/brandCapability" } } }
      }
    },
    "brandSourceOpen": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceHandle", "rootKind", "authorityKind", "packageId", "brandVersion", "brandSystemDigest", "brandManifestDigest", "consumerProfilesDigest", "profileCount", "assetCount", "companionCount", "capabilities"],
      "properties": {
        "sourceHandle": { "$ref": "#/$defs/handle" }, "rootKind": { "const": "source" }, "authorityKind": { "enum": ["brand-bundle", "npm-installed-package"] },
        "packageId": { "type": "string", "minLength": 1, "maxLength": 256 }, "brandVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "brandSystemDigest": { "$ref": "#/$defs/digest" }, "brandManifestDigest": { "$ref": "#/$defs/digest" }, "consumerProfilesDigest": { "$ref": "#/$defs/digest" },
        "profileCount": { "type": "integer", "minimum": 0 }, "assetCount": { "type": "integer", "minimum": 0 }, "companionCount": { "type": "integer", "minimum": 0 },
        "npmName": { "type": "string", "minLength": 1, "maxLength": 214 }, "npmVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "capabilities": { "type": "object", "additionalProperties": false, "required": ["analyze", "brandDiff", "consumerSource"], "properties": { "analyze": { "const": false }, "brandDiff": { "const": true }, "consumerSource": { "const": true } } }
      }
    },
    "brandStatus": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["present", "raster"], "properties": { "present": { "const": false }, "raster": { "$ref": "#/$defs/rasterStatus" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["present", "schemaVersion", "brandDigest", "brandSystemDigest", "domains", "counts", "completeness", "derived", "consumerLock", "export", "raster"],
          "properties": {
            "present": { "const": true }, "schemaVersion": { "const": 1 },
            "brandDigest": { "$ref": "#/$defs/digest" }, "brandSystemDigest": { "$ref": "#/$defs/nullableDigest" },
            "domains": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["domain", "state", "digest"], "properties": { "domain": { "type": "string" }, "state": { "type": "string" }, "digest": { "$ref": "#/$defs/nullableDigest" } } } },
            "counts": { "type": "object", "additionalProperties": false, "required": ["families", "roles", "variants", "bindings", "requirements", "tokens", "recipes", "qaProfiles", "qaCases", "qaBaselines", "consumerProfiles", "exportProfiles"], "properties": { "families": { "type": "integer", "minimum": 0 }, "roles": { "type": "integer", "minimum": 0 }, "variants": { "type": "integer", "minimum": 0 }, "bindings": { "type": "integer", "minimum": 0 }, "requirements": { "type": "integer", "minimum": 0 }, "tokens": { "type": "integer", "minimum": 0 }, "recipes": { "type": "integer", "minimum": 0 }, "qaProfiles": { "type": "integer", "minimum": 0 }, "qaCases": { "type": "integer", "minimum": 0 }, "qaBaselines": { "type": "integer", "minimum": 0 }, "consumerProfiles": { "type": "integer", "minimum": 0 }, "exportProfiles": { "type": "integer", "minimum": 0 } } },
            "completeness": { "type": "object", "additionalProperties": false, "required": ["satisfied", "familyCount", "variantCount", "bindingCount", "requirementCount"], "properties": { "satisfied": { "type": "boolean" }, "familyCount": { "type": "integer", "minimum": 0 }, "variantCount": { "type": "integer", "minimum": 0 }, "bindingCount": { "type": "integer", "minimum": 0 }, "requirementCount": { "type": "integer", "minimum": 0 } } },
            "derived": { "type": "object", "additionalProperties": false, "required": ["unchanged", "stale-authority", "missing-target", "human-owned", "target-drift", "invalid-receipt", "ownership-conflict"], "properties": { "unchanged": { "type": "integer", "minimum": 0 }, "stale-authority": { "type": "integer", "minimum": 0 }, "missing-target": { "type": "integer", "minimum": 0 }, "human-owned": { "type": "integer", "minimum": 0 }, "target-drift": { "type": "integer", "minimum": 0 }, "invalid-receipt": { "type": "integer", "minimum": 0 }, "ownership-conflict": { "type": "integer", "minimum": 0 } } },
            "consumerLock": { "type": "object", "additionalProperties": false, "required": ["present", "status", "packages", "profiles", "mappings"], "properties": { "present": { "type": "boolean" }, "status": { "enum": ["ok", "source-unavailable", "stale", "drift", "collision", "invalid"] }, "packages": { "type": "integer", "minimum": 0 }, "profiles": { "type": "integer", "minimum": 0 }, "mappings": { "type": "integer", "minimum": 0 } } },
            "export": { "type": "object", "additionalProperties": false, "required": ["outputs", "receipts"], "properties": { "outputs": { "type": "integer", "minimum": 0 }, "receipts": { "type": "integer", "minimum": 0 } } },
            "raster": { "$ref": "#/$defs/rasterStatus" }
          }
        }
      ]
    },
    "familyItem": { "type": "object", "additionalProperties": false, "required": ["id", "name", "requiredRoles", "optionalRoles", "variants", "bindings", "requirements", "complete"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "requiredRoles": { "type": "array", "items": { "type": "string" } }, "optionalRoles": { "type": "array", "items": { "type": "string" } }, "variants": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "bindings": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "requirements": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "complete": { "type": "boolean" } } },
    "tokenItem": { "type": "object", "additionalProperties": false, "required": ["id", "type", "referenceCount", "recipeUseCount", "unused"], "properties": { "id": { "type": "string" }, "type": { "enum": ["color", "gradient", "dimension", "opacity"] }, "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] }, "kind": { "const": "linear" }, "units": { "type": "string" }, "unit": { "type": "string" }, "x1": { "type": "number" }, "y1": { "type": "number" }, "x2": { "type": "number" }, "y2": { "type": "number" }, "stops": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/json" } }, "referenceCount": { "type": "integer", "minimum": 0 }, "recipeUseCount": { "type": "integer", "minimum": 0 }, "unused": { "type": "boolean" } } },
    "consumerProfileItem": { "type": "object", "additionalProperties": false, "required": ["qualifiedProfileId", "authorityKind", "packageId", "profile", "outputRuleCount", "resolvedOutputCount"], "properties": { "qualifiedProfileId": { "type": "string" }, "authorityKind": { "enum": ["producer-project", "producer-package", "consumer-local"] }, "packageId": { "type": "string" }, "profile": { "$ref": "#/$defs/json" }, "outputRuleCount": { "type": "integer", "minimum": 0 }, "resolvedOutputCount": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] } } },
    "exportStatusItem": { "type": "object", "additionalProperties": false, "required": ["profileId", "outputId", "assetId", "binding", "destination", "state", "width", "height", "purpose", "background", "alpha", "canonicalAssetDigest", "svgDigest", "profileDigest", "outputConfigDigest", "pngDigest", "decodedPixelDigest", "receiptDigest", "capabilityAvailable"], "properties": { "profileId": { "type": "string" }, "outputId": { "type": "string" }, "assetId": { "oneOf": [{ "type": "string" }, { "type": "null" }] }, "binding": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["family", "role", "variant"], "properties": { "family": { "type": "string" }, "role": { "type": "string" }, "variant": { "type": "string" } } }, { "type": "null" }] }, "destination": { "$ref": "#/$defs/relativeIdentity" }, "state": { "type": "string" }, "width": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "height": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "purpose": { "oneOf": [{ "type": "string" }, { "type": "null" }] }, "background": { "oneOf": [{ "type": "string" }, { "type": "null" }] }, "alpha": { "enum": ["straight", "opaque", null] }, "canonicalAssetDigest": { "$ref": "#/$defs/nullableDigest" }, "svgDigest": { "$ref": "#/$defs/nullableDigest" }, "profileDigest": { "$ref": "#/$defs/nullableDigest" }, "outputConfigDigest": { "$ref": "#/$defs/nullableDigest" }, "pngDigest": { "$ref": "#/$defs/nullableDigest" }, "decodedPixelDigest": { "$ref": "#/$defs/nullableDigest" }, "receiptDigest": { "$ref": "#/$defs/nullableDigest" }, "capabilityAvailable": { "type": "boolean" } } },
    "page": { "type": "object", "additionalProperties": false, "required": ["page", "viewDigest"], "properties": { "page": { "type": "object", "additionalProperties": false, "required": ["size", "count", "items", "nextCursor"], "properties": { "size": { "type": "integer", "minimum": 1, "maximum": 128 }, "count": { "type": "integer", "minimum": 0, "maximum": 128 }, "items": { "type": "array", "maxItems": 128, "items": { "oneOf": [{ "$ref": "#/$defs/familyItem" }, { "$ref": "#/$defs/tokenItem" }, { "$ref": "#/$defs/consumerProfileItem" }, { "$ref": "#/$defs/exportStatusItem" }] } }, "nextCursor": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 16384 }, { "type": "null" }] } } }, "viewDigest": { "$ref": "#/$defs/digest" } } },
    "recipeGraph": { "type": "object", "additionalProperties": false, "required": ["recipeDigest", "graphDigest", "nodes", "affectedTargetCount", "ownershipConflicts"], "properties": { "recipeDigest": { "$ref": "#/$defs/digest" }, "graphDigest": { "$ref": "#/$defs/digest" }, "nodes": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/json" } }, "affectedTargetCount": { "type": "integer", "minimum": 0, "maximum": 128 }, "ownershipConflicts": { "type": "integer", "minimum": 0, "maximum": 128 } } },
    "qaProfile": { "type": "object", "additionalProperties": false, "required": ["profile", "cases", "resolvedTargetCount", "evaluationCount", "qaDigest", "brandSystemDigest", "baselines", "raster"], "properties": { "profile": { "$ref": "#/$defs/json" }, "cases": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "resolvedTargetCount": { "type": "integer", "minimum": 0 }, "evaluationCount": { "type": "integer", "minimum": 0 }, "qaDigest": { "$ref": "#/$defs/digest" }, "brandSystemDigest": { "$ref": "#/$defs/digest" }, "baselines": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["identity", "digest"], "properties": { "identity": { "$ref": "#/$defs/relativeIdentity" }, "digest": { "$ref": "#/$defs/nullableDigest" } } } }, "raster": { "$ref": "#/$defs/rasterStatus" } } },
    "qaResult": { "type": "object", "additionalProperties": false, "required": ["schema", "schemaVersion", "profileId", "qaDigest", "brandSystemDigest", "status", "exitCode", "counts", "results", "resultDigest"], "properties": { "schema": { "const": "tfsb.brand-qa-result" }, "schemaVersion": { "const": 1 }, "profileId": { "type": "string" }, "qaDigest": { "$ref": "#/$defs/digest" }, "brandSystemDigest": { "$ref": "#/$defs/digest" }, "status": { "enum": ["pass", "fail", "skipped", "unavailable", "error"] }, "exitCode": { "type": "integer", "minimum": 0, "maximum": 3 }, "counts": { "type": "object", "additionalProperties": false, "required": ["pass", "fail", "skipped", "unavailable", "error"], "properties": { "pass": { "type": "integer", "minimum": 0 }, "fail": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 }, "unavailable": { "type": "integer", "minimum": 0 }, "error": { "type": "integer", "minimum": 0 } } }, "renderer": { "$ref": "#/$defs/json" }, "results": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "resultDigest": { "$ref": "#/$defs/digest" } } },
    "brandDiff": { "type": "object", "additionalProperties": false, "required": ["diff", "beforeBindingDigest", "afterBindingDigest", "visualDiff"], "properties": { "diff": { "type": "object", "additionalProperties": false, "required": ["schema", "schemaVersion", "beforeDigest", "afterDigest", "status", "inventory", "bindings", "tokens", "recipes", "derived", "geometry", "qaImpact", "packageAndLegal", "consumerProfiles", "exports", "resultDigest"], "properties": { "schema": { "const": "tfsb.brand-diff" }, "schemaVersion": { "const": 1 }, "beforeDigest": { "$ref": "#/$defs/digest" }, "afterDigest": { "$ref": "#/$defs/digest" }, "status": { "enum": ["equal", "changed"] }, "inventory": { "$ref": "#/$defs/json" }, "bindings": { "$ref": "#/$defs/json" }, "tokens": { "$ref": "#/$defs/json" }, "recipes": { "$ref": "#/$defs/json" }, "derived": { "$ref": "#/$defs/json" }, "geometry": { "$ref": "#/$defs/json" }, "qaImpact": { "$ref": "#/$defs/json" }, "packageAndLegal": { "$ref": "#/$defs/json" }, "consumerProfiles": { "$ref": "#/$defs/json" }, "exports": { "$ref": "#/$defs/json" }, "resultDigest": { "$ref": "#/$defs/digest" } } }, "beforeBindingDigest": { "$ref": "#/$defs/digest" }, "afterBindingDigest": { "$ref": "#/$defs/digest" }, "visualDiff": { "$ref": "#/$defs/rasterStatus" } } },
    "consumerState": { "type": "object", "additionalProperties": false, "required": ["status", "exitCode", "packages", "mappings", "localProfiles"], "properties": { "status": { "enum": ["ok", "source-unavailable", "stale", "drift", "collision", "invalid"] }, "exitCode": { "enum": [0, 1, 2] }, "lockDigest": { "$ref": "#/$defs/digest" }, "consumerProjectDigest": { "$ref": "#/$defs/digest" }, "packages": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/json" } }, "mappings": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "localProfiles": { "type": "array", "items": { "type": "string" } } } },
    "exportCapability": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["available"], "properties": { "available": { "const": false } } }, { "type": "object", "additionalProperties": false, "required": ["available", "adapterId", "rendererPackage", "rendererVersion", "rendererBuildDigest", "nodeMajor", "platformClaim", "qualificationId"], "properties": { "available": { "const": true }, "adapterId": { "const": "resvg-png-v1" }, "rendererPackage": { "const": "@resvg/resvg-wasm" }, "rendererVersion": { "const": "2.6.2" }, "rendererBuildDigest": { "$ref": "#/$defs/digest" }, "nodeMajor": { "const": 22 }, "platformClaim": { "const": "darwin-arm64" }, "qualificationId": { "type": "string" } } }] },
    "derivePlanSummary": { "type": "object", "additionalProperties": false, "required": ["selectedRecipes", "transitiveRecipes", "affectedTargets", "createdCount", "updatedCount", "unchangedCount", "operationSummaries", "targetStates", "tokenDigest", "recipeDigest", "brandSystemDigest", "warnings", "dryRun"], "properties": { "selectedRecipes": { "type": "array", "maxItems": 128, "items": { "type": "string" } }, "transitiveRecipes": { "type": "array", "maxItems": 128, "items": { "type": "string" } }, "affectedTargets": { "type": "array", "maxItems": 128, "items": { "type": "string" } }, "createdCount": { "type": "integer", "minimum": 0 }, "updatedCount": { "type": "integer", "minimum": 0 }, "unchangedCount": { "type": "integer", "minimum": 0 }, "operationSummaries": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/json" } }, "targetStates": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/json" } }, "tokenDigest": { "$ref": "#/$defs/digest" }, "recipeDigest": { "$ref": "#/$defs/digest" }, "brandSystemDigest": { "$ref": "#/$defs/digest" }, "warnings": { "type": "array", "items": { "type": "string" } }, "dryRun": { "type": "boolean" } } },
    "baselinePlanSummary": { "type": "object", "additionalProperties": false, "required": ["profileId", "caseId", "baselinePath", "state", "oldBaselineDigest", "newBaselineDigest", "oldQaDigest", "newQaDigest", "renderer", "assetDigests", "svgDigests", "brandSystemDigests", "rasterDifference"], "properties": { "profileId": { "type": "string" }, "caseId": { "type": "string" }, "baselinePath": { "$ref": "#/$defs/relativeIdentity" }, "state": { "enum": ["create", "update", "rebaseline"] }, "oldBaselineDigest": { "$ref": "#/$defs/nullableDigest" }, "newBaselineDigest": { "$ref": "#/$defs/digest" }, "oldQaDigest": { "$ref": "#/$defs/digest" }, "newQaDigest": { "$ref": "#/$defs/digest" }, "renderer": { "type": "object", "additionalProperties": false, "required": ["id", "version", "qualificationId", "platformClaim", "rendererBuildDigest"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "qualificationId": { "type": "string" }, "platformClaim": { "type": "string" }, "rendererBuildDigest": { "$ref": "#/$defs/digest" } } }, "assetDigests": { "$ref": "#/$defs/digestPair" }, "svgDigests": { "$ref": "#/$defs/digestPair" }, "brandSystemDigests": { "$ref": "#/$defs/digestPair" }, "rasterDifference": { "$ref": "#/$defs/json" } } },
    "digestPair": { "type": "object", "additionalProperties": false, "required": ["old", "next"], "properties": { "old": { "$ref": "#/$defs/digest" }, "next": { "$ref": "#/$defs/digest" } } },
    "consumerPlanSummary": { "type": "object", "additionalProperties": false, "required": ["operation", "packages", "profiles", "outputs", "omittedOptional", "lockDigest"], "properties": { "operation": { "enum": ["install", "sync"] }, "packages": { "type": "array", "maxItems": 8, "items": { "type": "string" } }, "profiles": { "type": "array", "maxItems": 8, "items": { "type": "string" } }, "outputs": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/json" } }, "omittedOptional": { "type": "array", "maxItems": 512, "items": { "type": "string" } }, "lockDigest": { "$ref": "#/$defs/digest" } } },
    "exportPlanSummary": { "type": "object", "additionalProperties": false, "required": ["profileId", "adapter", "outputs", "counts", "warnings"], "properties": { "profileId": { "type": "string" }, "adapter": { "$ref": "#/$defs/json" }, "outputs": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/json" } }, "counts": { "type": "object", "additionalProperties": false, "required": ["create", "update", "unchanged"], "properties": { "create": { "type": "integer", "minimum": 0 }, "update": { "type": "integer", "minimum": 0 }, "unchanged": { "type": "integer", "minimum": 0 } } }, "warnings": { "type": "array", "items": { "type": "string" } } } },
    "planResult": { "type": "object", "additionalProperties": false, "required": ["planToken", "planDigest", "expiresInMs", "method", "summary"], "properties": { "planToken": { "$ref": "#/$defs/token" }, "planDigest": { "$ref": "#/$defs/digest" }, "expiresInMs": { "const": 600000 }, "method": { "enum": ["brand.derive.plan", "brand.qa.baseline.plan", "brand.consumer.install.plan", "brand.consumer.sync.plan", "brand.export.plan"] }, "summary": { "oneOf": [{ "$ref": "#/$defs/derivePlanSummary" }, { "$ref": "#/$defs/baselinePlanSummary" }, { "$ref": "#/$defs/consumerPlanSummary" }, { "$ref": "#/$defs/exportPlanSummary" }] } } },
    "success": { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "result"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/id" }, "result": { "oneOf": [{ "$ref": "#/$defs/initializeResult" }, { "$ref": "#/$defs/brandSourceOpen" }, { "$ref": "#/$defs/brandStatus" }, { "$ref": "#/$defs/page" }, { "$ref": "#/$defs/recipeGraph" }, { "$ref": "#/$defs/qaProfile" }, { "$ref": "#/$defs/qaResult" }, { "$ref": "#/$defs/brandDiff" }, { "$ref": "#/$defs/consumerState" }, { "$ref": "#/$defs/exportCapability" }, { "$ref": "#/$defs/planResult" }] } } }
  },
  "anyOf": [
    { "$ref": "results.schema.json" },
    { "$ref": "#/$defs/success" }
  ]
}
