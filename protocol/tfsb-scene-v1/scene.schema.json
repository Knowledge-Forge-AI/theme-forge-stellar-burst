{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.ai/tfsb/scene/v1/scene.schema.json",
  "title": "TFSB vector scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "compatibility",
    "compilerLevel",
    "profile",
    "artboard",
    "accessibility",
    "elements"
  ],
  "properties": {
    "schema": {
      "const": "tfsb.vector-scene-v1"
    },
    "compatibility": {
      "const": 1
    },
    "compilerLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Minimum semantic compiler level required by this document. A compiler accepts supported levels up to its own level; compatibility remains the schema gate."
    },
    "profile": {
      "enum": [
        "illustration",
        "diagram",
        "editorial",
        "promotional",
        "pattern"
      ]
    },
    "artboard": {
      "$ref": "#/$defs/artboard"
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/sceneElement"
      }
    },
    "definitions": {
      "$ref": "#/$defs/definitions"
    },
    "tokenBindings": {
      "$ref": "#/$defs/tokenBindings"
    },
    "layout": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/layoutDirective"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "artboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "viewBox"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false
        },
        "policy": {
          "enum": [
            "contain",
            "pad"
          ]
        }
      }
    },
    "accessibility": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "title"
          ],
          "properties": {
            "mode": {
              "const": "labelled"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "desc": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "focusable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "decorative"
            },
            "focusable": {
              "const": false
            }
          }
        }
      ]
    },
    "paint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "currentColor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "const": "solid"
            },
            "color": {
              "$ref": "#/$defs/hexColor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "token"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "gradient"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "fallback": {
              "$ref": "#/$defs/hexColor"
            }
          }
        }
      ]
    },
    "paintNotGradient": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "currentColor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "const": "solid"
            },
            "color": {
              "$ref": "#/$defs/hexColor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "token"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "strokeDasharray": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "strokeDashoffset": {
          "type": "number"
        },
        "strokeLinecap": {
          "enum": [
            "butt",
            "round",
            "square"
          ]
        },
        "strokeLinejoin": {
          "enum": [
            "miter",
            "round",
            "bevel"
          ]
        },
        "strokeMiterlimit": {
          "type": "number",
          "minimum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strokeOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fillRule": {
          "enum": [
            "nonzero",
            "evenodd"
          ]
        },
        "clipRule": {
          "enum": [
            "nonzero",
            "evenodd"
          ]
        },
        "ariaHidden": {
          "type": "boolean"
        }
      }
    },
    "transformOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "x"
          ],
          "properties": {
            "type": {
              "const": "translate"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "x"
          ],
          "properties": {
            "type": {
              "const": "scale"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ],
          "properties": {
            "type": {
              "const": "rotate"
            },
            "angle": {
              "type": "number"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            }
          },
          "dependentRequired": {
            "cx": [
              "cy"
            ],
            "cy": [
              "cx"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "c",
            "d",
            "e",
            "f"
          ],
          "properties": {
            "type": {
              "const": "matrix"
            },
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "e": {
              "type": "number"
            },
            "f": {
              "type": "number"
            }
          }
        }
      ]
    },
    "transforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transformOperation"
      },
      "maxItems": 32
    },
    "gradientStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "color"
      ],
      "properties": {
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "$ref": "#/$defs/paintNotGradient"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "linearGradient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "x1",
        "y1",
        "x2",
        "y2",
        "stops"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "linearGradient"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "x2": {
          "type": "number"
        },
        "y2": {
          "type": "number"
        },
        "gradientUnits": {
          "enum": [
            "userSpaceOnUse",
            "objectBoundingBox"
          ]
        },
        "spreadMethod": {
          "const": "pad"
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/gradientStop"
          }
        }
      }
    },
    "radialGradient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "cx",
        "cy",
        "r",
        "stops"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "radialGradient"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fx": {
          "type": "number"
        },
        "fy": {
          "type": "number"
        },
        "gradientUnits": {
          "enum": [
            "userSpaceOnUse",
            "objectBoundingBox"
          ]
        },
        "spreadMethod": {
          "const": "pad"
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/gradientStop"
          }
        }
      }
    },
    "symbolDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "viewBox",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "symbol"
        },
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sceneElement"
          }
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gradients": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/linearGradient"
              },
              {
                "$ref": "#/$defs/radialGradient"
              }
            ]
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/symbolDef"
          }
        }
      }
    },
    "tokenBindings": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/hexColor"
          },
          {
            "type": "string",
            "pattern": "^token:[A-Za-z_][A-Za-z0-9_.-]*$"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      },
      "maxProperties": 1000
    },
    "connectorEndpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elementId",
            "anchor"
          ],
          "properties": {
            "elementId": {
              "$ref": "#/$defs/id"
            },
            "anchor": {
              "enum": [
                "top",
                "bottom",
                "left",
                "right",
                "center"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      ]
    },
    "sceneElement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "d"
          ],
          "properties": {
            "type": {
              "const": "path"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "d": {
              "type": "string",
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "type": {
              "const": "rect"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "rx": {
              "type": "number",
              "minimum": 0
            },
            "ry": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cx",
            "cy",
            "r"
          ],
          "properties": {
            "type": {
              "const": "circle"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "r": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cx",
            "cy",
            "rx",
            "ry"
          ],
          "properties": {
            "type": {
              "const": "ellipse"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "rx": {
              "type": "number",
              "minimum": 0
            },
            "ry": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "properties": {
            "type": {
              "const": "line"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "const": "polyline"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "maxItems": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "const": "polygon"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "maxItems": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "group"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sceneElement"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "href"
          ],
          "properties": {
            "type": {
              "const": "use"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "href": {
              "type": "string",
              "pattern": "^#[A-Za-z_][A-Za-z0-9_.-]*$"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "type": {
              "const": "diagramNode"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "rx": {
              "type": "number",
              "minimum": 0
            },
            "ry": {
              "type": "number",
              "minimum": 0
            },
            "label": {
              "type": "string",
              "maxLength": 1024
            },
            "labelColor": {
              "$ref": "#/$defs/paint"
            },
            "labelScale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "routing",
            "from",
            "to"
          ],
          "properties": {
            "type": {
              "const": "connector"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "routing": {
              "enum": [
                "straight",
                "orthogonal"
              ]
            },
            "from": {
              "$ref": "#/$defs/connectorEndpoint"
            },
            "to": {
              "$ref": "#/$defs/connectorEndpoint"
            },
            "waypoints": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "startArrowhead": {
              "enum": [
                "none",
                "triangle",
                "chevron"
              ]
            },
            "endArrowhead": {
              "enum": [
                "none",
                "triangle",
                "chevron"
              ]
            },
            "arrowheadSize": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "x",
            "y"
          ],
          "properties": {
            "type": {
              "const": "label"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            },
            "transform": {
              "$ref": "#/$defs/transforms"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "text": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[\\x20-\\x7E\\n]*$"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "$ref": "#/$defs/paint"
            },
            "lineSpacing": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            }
          }
        }
      ]
    },
    "layoutDirective": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "alignment",
            "targets"
          ],
          "properties": {
            "type": {
              "const": "align"
            },
            "alignment": {
              "enum": [
                "left",
                "center",
                "right",
                "top",
                "middle",
                "bottom"
              ]
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "relativeTo": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "axis",
            "targets"
          ],
          "properties": {
            "type": {
              "const": "distribute"
            },
            "axis": {
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "targets": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "spacing": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "targets",
            "columns"
          ],
          "properties": {
            "type": {
              "const": "grid"
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "columns": {
              "type": "integer",
              "minimum": 1
            },
            "columnGap": {
              "type": "number"
            },
            "rowGap": {
              "type": "number"
            },
            "startX": {
              "type": "number"
            },
            "startY": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "targetAnchor",
            "relativeTo",
            "relativeToAnchor"
          ],
          "properties": {
            "type": {
              "const": "anchor"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "targetAnchor": {
              "enum": [
                "top",
                "bottom",
                "left",
                "right",
                "center"
              ]
            },
            "relativeTo": {
              "$ref": "#/$defs/id"
            },
            "relativeToAnchor": {
              "enum": [
                "top",
                "bottom",
                "left",
                "right",
                "center"
              ]
            },
            "offsetX": {
              "type": "number"
            },
            "offsetY": {
              "type": "number"
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "license": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71,
          "minLength": 1
        },
        "created": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "note": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      }
    }
  }
}
